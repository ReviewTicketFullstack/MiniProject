+
+// 주문 취소 가능 여부 판단
+export function isCancellable(order: Order): boolean {
+  // 이미 취소된 주문은 취소 불가
+  if (order.cancelled) return false;
+  // 리뷰가 완료된 주문은 취소 불가
+  if (order.reviewStatus === "done") return false;
+  return true;
 }
